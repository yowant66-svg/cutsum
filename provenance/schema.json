{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CutSum provenance ledger",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "classification",
          "source_path",
          "source_symbol",
          "source_lines",
          "source_sha256",
          "target_path",
          "reviewer",
          "reviewed_at"
        ]
      }
    }
  },
  "additionalProperties": false
}
