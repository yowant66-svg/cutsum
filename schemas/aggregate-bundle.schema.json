{
  "$defs": {
    "CandidateAggregate": {
      "additionalProperties": false,
      "properties": {
        "advisory_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/DimensionKey"
          },
          "title": "Advisory Scores",
          "type": "object"
        },
        "calculation_version": {
          "title": "Calculation Version",
          "type": "string"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "exclusion_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Exclusion Reasons",
          "type": "array"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "model_reported_overall_ignored": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Reported Overall Ignored"
        },
        "normalized_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/DimensionKey"
          },
          "title": "Normalized Weights",
          "type": "object"
        },
        "overall": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overall"
        },
        "required_passed": {
          "title": "Required Passed",
          "type": "boolean"
        }
      },
      "required": [
        "candidate_id",
        "required_passed",
        "calculation_version",
        "input_sha256"
      ],
      "title": "CandidateAggregate",
      "type": "object"
    },
    "DimensionKey": {
      "enum": [
        "insight",
        "novelty",
        "emotion",
        "quotability",
        "hook",
        "standalone",
        "clarity",
        "completion",
        "shareability",
        "silent_watchability",
        "pace",
        "editability",
        "subtitle_reliability",
        "visual_independence"
      ],
      "title": "DimensionKey",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "aggregate_bundle_id": {
      "title": "Aggregate Bundle Id",
      "type": "string"
    },
    "aggregates": {
      "items": {
        "$ref": "#/$defs/CandidateAggregate"
      },
      "title": "Aggregates",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "document_type": {
      "title": "Document Type",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "input_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Document Sha256",
      "type": "string"
    },
    "required_extensions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Extensions",
      "type": "array"
    },
    "resolved_task_id": {
      "title": "Resolved Task Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "document_type",
    "created_at",
    "created_by",
    "aggregate_bundle_id",
    "source_id",
    "resolved_task_id",
    "aggregates",
    "input_document_sha256"
  ],
  "title": "AggregateBundle",
  "type": "object"
}
