{
  "$defs": {
    "CandidateAssessment": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "content_track_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Content Track Ids",
          "type": "array"
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/DimensionAssessment"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "model_reported_overall": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Reported Overall"
        }
      },
      "required": [
        "candidate_id",
        "dimensions"
      ],
      "title": "CandidateAssessment",
      "type": "object"
    },
    "DimensionAssessment": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "dimension": {
          "$ref": "#/$defs/DimensionKey"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        }
      },
      "required": [
        "dimension",
        "explanation"
      ],
      "title": "DimensionAssessment",
      "type": "object"
    },
    "DimensionKey": {
      "enum": [
        "insight",
        "novelty",
        "emotion",
        "quotability",
        "hook",
        "standalone",
        "clarity",
        "completion",
        "shareability",
        "silent_watchability",
        "pace",
        "editability",
        "subtitle_reliability",
        "visual_independence"
      ],
      "title": "DimensionKey",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "assessment_bundle_id": {
      "title": "Assessment Bundle Id",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateAssessment"
      },
      "title": "Candidates",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "document_type": {
      "title": "Document Type",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "input_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Document Sha256",
      "type": "string"
    },
    "is_fixture": {
      "default": false,
      "title": "Is Fixture",
      "type": "boolean"
    },
    "provider_kind": {
      "enum": [
        "fixture",
        "host_ai_file",
        "human_file"
      ],
      "title": "Provider Kind",
      "type": "string"
    },
    "provider_record_ref": {
      "title": "Provider Record Ref",
      "type": "string"
    },
    "required_extensions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Extensions",
      "type": "array"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "document_type",
    "created_at",
    "created_by",
    "assessment_bundle_id",
    "source_id",
    "provider_record_ref",
    "provider_kind",
    "candidates",
    "input_document_sha256"
  ],
  "title": "AssessmentBundle",
  "type": "object"
}
