{
  "$defs": {
    "AvailabilityStatus": {
      "enum": [
        "available",
        "partial",
        "unavailable",
        "not_verified"
      ],
      "title": "AvailabilityStatus",
      "type": "string"
    },
    "BenchmarkCategory": {
      "enum": [
        "interview_or_talk",
        "film_or_drama",
        "education_or_knowledge"
      ],
      "title": "BenchmarkCategory",
      "type": "string"
    },
    "BenchmarkEvaluationStatus": {
      "enum": [
        "selected",
        "ready",
        "blocked",
        "completed"
      ],
      "title": "BenchmarkEvaluationStatus",
      "type": "string"
    },
    "BenchmarkExecutionPolicy": {
      "additionalProperties": false,
      "properties": {
        "analysis_window": {
          "$ref": "#/$defs/TimeRange"
        },
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "maximum_cost_minor_units": {
          "default": 0,
          "minimum": 0,
          "title": "Maximum Cost Minor Units",
          "type": "integer"
        },
        "media_download_permitted": {
          "default": false,
          "title": "Media Download Permitted",
          "type": "boolean"
        },
        "media_execution_permitted": {
          "default": false,
          "title": "Media Execution Permitted",
          "type": "boolean"
        },
        "network_provider_permitted": {
          "default": false,
          "title": "Network Provider Permitted",
          "type": "boolean"
        },
        "plan_only": {
          "default": true,
          "title": "Plan Only",
          "type": "boolean"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "analysis_window",
        "rationale"
      ],
      "title": "BenchmarkExecutionPolicy",
      "type": "object"
    },
    "BenchmarkItem": {
      "additionalProperties": false,
      "properties": {
        "accessed_at": {
          "format": "date-time",
          "title": "Accessed At",
          "type": "string"
        },
        "auto_task": {
          "$ref": "#/$defs/BenchmarkTaskSpec"
        },
        "benchmark_id": {
          "title": "Benchmark Id",
          "type": "string"
        },
        "benchmark_version": {
          "title": "Benchmark Version",
          "type": "string"
        },
        "canonical_subject": {
          "title": "Canonical Subject",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/BenchmarkCategory"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "directed_tasks": {
          "items": {
            "$ref": "#/$defs/BenchmarkTaskSpec"
          },
          "minItems": 2,
          "title": "Directed Tasks",
          "type": "array"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "evaluation_status": {
          "$ref": "#/$defs/BenchmarkEvaluationStatus"
        },
        "execution_policy": {
          "$ref": "#/$defs/BenchmarkExecutionPolicy"
        },
        "expected_content_structure": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Expected Content Structure",
          "type": "array"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "known_difficulties": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Known Difficulties",
          "type": "array"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "media_availability": {
          "$ref": "#/$defs/AvailabilityStatus"
        },
        "publication_or_release_date": {
          "pattern": "^\\d{4}(?:-\\d{2}-\\d{2})?$",
          "title": "Publication Or Release Date",
          "type": "string"
        },
        "rights_notes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Rights Notes",
          "type": "array"
        },
        "selection_rationale": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Selection Rationale",
          "type": "array"
        },
        "source_kind": {
          "$ref": "#/$defs/BenchmarkSourceKind"
        },
        "source_notes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Notes",
          "type": "array"
        },
        "source_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "transcript_availability": {
          "$ref": "#/$defs/AvailabilityStatus"
        }
      },
      "required": [
        "benchmark_id",
        "benchmark_version",
        "item_id",
        "category",
        "title",
        "canonical_subject",
        "source_url",
        "source_kind",
        "media_availability",
        "transcript_availability",
        "duration_ms",
        "language",
        "publication_or_release_date",
        "accessed_at",
        "content_hash",
        "source_notes",
        "rights_notes",
        "selection_rationale",
        "expected_content_structure",
        "auto_task",
        "directed_tasks",
        "execution_policy",
        "evaluation_status"
      ],
      "title": "BenchmarkItem",
      "type": "object"
    },
    "BenchmarkSourceKind": {
      "enum": [
        "youtube_video",
        "official_clip",
        "official_trailer",
        "public_transcript",
        "subtitle_file",
        "open_course_media",
        "public_domain_media",
        "other_public_source"
      ],
      "title": "BenchmarkSourceKind",
      "type": "string"
    },
    "BenchmarkTaskSpec": {
      "additionalProperties": false,
      "properties": {
        "clip_constraints": {
          "$ref": "#/$defs/ClipConstraints",
          "default": {
            "absolute_auto_max_duration_ms": null,
            "default_max_duration_ms": null,
            "duration_source": null,
            "extension_reason": null,
            "host_requested_duration_ms": null,
            "maximum_count": null,
            "maximum_duration_ms": null,
            "minimum_count": null,
            "minimum_duration_ms": null,
            "preferred_duration_ms": null,
            "target_count": null,
            "target_duration_ms": null
          }
        },
        "control_mode": {
          "$ref": "#/$defs/ControlMode"
        },
        "desired_outcomes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Desired Outcomes",
          "type": "array"
        },
        "hard_exclude_candidate_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Hard Exclude Candidate Ids",
          "type": "array"
        },
        "hard_include_candidate_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Hard Include Candidate Ids",
          "type": "array"
        },
        "preserve_time_order": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preserve Time Order"
        },
        "prohibited_outcomes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prohibited Outcomes",
          "type": "array"
        },
        "raw_instruction": {
          "title": "Raw Instruction",
          "type": "string"
        },
        "require_track_diversity": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Require Track Diversity"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "control_mode",
        "raw_instruction"
      ],
      "title": "BenchmarkTaskSpec",
      "type": "object"
    },
    "ClipConstraints": {
      "additionalProperties": false,
      "properties": {
        "absolute_auto_max_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Absolute Auto Max Duration Ms"
        },
        "default_max_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Max Duration Ms"
        },
        "duration_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/DurationSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "extension_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extension Reason"
        },
        "host_requested_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host Requested Duration Ms"
        },
        "maximum_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Count"
        },
        "maximum_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Duration Ms"
        },
        "minimum_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Count"
        },
        "minimum_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Duration Ms"
        },
        "preferred_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Duration Ms"
        },
        "target_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Count"
        },
        "target_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Duration Ms"
        }
      },
      "title": "ClipConstraints",
      "type": "object"
    },
    "ControlMode": {
      "enum": [
        "auto",
        "guided",
        "directed"
      ],
      "title": "ControlMode",
      "type": "string"
    },
    "DurationSource": {
      "enum": [
        "host_explicit",
        "content_inference",
        "default_policy",
        "automatic_extension"
      ],
      "title": "DurationSource",
      "type": "string"
    },
    "JsonValue": {},
    "TimeRange": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "start_ms",
        "end_ms"
      ],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_version": {
      "title": "Benchmark Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "document_type": {
      "title": "Document Type",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/BenchmarkItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "required_extensions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Extensions",
      "type": "array"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "document_type",
    "created_at",
    "created_by",
    "benchmark_id",
    "benchmark_version",
    "items"
  ],
  "title": "BenchmarkManifest",
  "type": "object"
}
