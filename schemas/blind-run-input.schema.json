{
  "$defs": {
    "BlindEvaluationTrack": {
      "enum": [
        "interview",
        "drama",
        "education",
        "sports"
      ],
      "title": "BlindEvaluationTrack",
      "type": "string"
    },
    "BlindTaskInput": {
      "additionalProperties": false,
      "properties": {
        "control_mode": {
          "$ref": "#/$defs/ControlMode"
        },
        "raw_instruction": {
          "title": "Raw Instruction",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "control_mode",
        "raw_instruction"
      ],
      "title": "BlindTaskInput",
      "type": "object"
    },
    "ControlMode": {
      "enum": [
        "auto",
        "guided",
        "directed"
      ],
      "title": "ControlMode",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "blind_run_id": {
      "title": "Blind Run Id",
      "type": "string"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "document_type": {
      "title": "Document Type",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "media_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Path"
    },
    "required_extensions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Extensions",
      "type": "array"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "suite_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suite Id"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/BlindTaskInput"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Tasks",
      "type": "array"
    },
    "track": {
      "anyOf": [
        {
          "$ref": "#/$defs/BlindEvaluationTrack"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "transcript_path": {
      "title": "Transcript Path",
      "type": "string"
    }
  },
  "required": [
    "document_type",
    "created_at",
    "created_by",
    "blind_run_id",
    "sample_id",
    "source_id",
    "transcript_path",
    "tasks"
  ],
  "title": "BlindRunInput",
  "type": "object"
}
