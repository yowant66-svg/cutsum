        },
        "input_hashes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
