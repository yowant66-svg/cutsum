        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "output_hashes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Output Hashes",
          "type": "array"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "provider_record_id": {
          "title": "Provider Record Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "started_at",
        "completed_at",
        "provider_record_id",
        "provider_id",
        "operation"
      ],
      "title": "ProviderRecord",
      "type": "object"
    },
    "StepResult": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
