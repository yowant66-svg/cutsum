        },
        "recoverable": {
          "default": false,
          "title": "Recoverable",
          "type": "boolean"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "timed_out"
