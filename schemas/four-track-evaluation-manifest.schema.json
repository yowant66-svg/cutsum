{
  "$defs": {
    "EvaluationEvidenceClass": {
      "enum": [
        "real_local",
        "synthetic",
        "curated_protocol"
      ],
      "title": "EvaluationEvidenceClass",
      "type": "string"
    },
    "EvaluationTrack": {
      "enum": [
        "interview",
        "drama",
        "education",
        "sports"
      ],
      "title": "EvaluationTrack",
      "type": "string"
    },
    "EvaluationType": {
      "enum": [
        "capability",
        "regression",
        "human_review"
      ],
      "title": "EvaluationType",
      "type": "string"
    },
    "FourTrackCaseDefinition": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "evaluation_type": {
          "$ref": "#/$defs/EvaluationType"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvaluationEvidenceClass"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Refs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "runner": {
          "enum": [
            "standard_v1_interview",
            "standard_v1_drama",
            "educational_v1",
            "sports_alpha"
          ],
          "title": "Runner",
          "type": "string"
        },
        "supplemental_artifact_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supplemental Artifact Refs",
          "type": "array"
        },
        "track": {
          "$ref": "#/$defs/EvaluationTrack"
        }
      },
      "required": [
        "case_id",
        "track",
        "evaluation_type",
        "evidence_class",
        "runner",
        "input_refs",
        "limitations"
      ],
      "title": "FourTrackCaseDefinition",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/FourTrackCaseDefinition"
      },
      "minItems": 4,
      "title": "Cases",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "document_type": {
      "title": "Document Type",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "required_extensions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Extensions",
      "type": "array"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "suite_id": {
      "title": "Suite Id",
      "type": "string"
    },
    "suite_version": {
      "title": "Suite Version",
      "type": "string"
    }
  },
  "required": [
    "document_type",
    "created_at",
    "created_by",
    "suite_id",
    "suite_version",
    "cases"
  ],
  "title": "FourTrackEvaluationManifest",
  "type": "object"
}
