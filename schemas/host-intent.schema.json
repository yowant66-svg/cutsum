        "required_count": {
          "default": 1,
          "minimum": 1,
          "title": "Required Count",
          "type": "integer"
        },
        "required_structure": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Structure",
          "type": "array"
        },
        "semantic_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sequence_constraint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
