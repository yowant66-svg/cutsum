        },
        "speaker_constraint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker Constraint"
        },
        "topic_constraint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Constraint"
        }
      },
      "title": "SemanticRequirements",
      "type": "object"
    },
    "SemanticType": {
      "enum": [
        "definition",
        "reasoning_chain",
        "conflict",
        "hook",
        "step",
        "story_arc"
      ],
