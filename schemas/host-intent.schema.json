{
  "$defs": {
    "ClipConstraints": {
      "additionalProperties": false,
      "properties": {
        "absolute_auto_max_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Absolute Auto Max Duration Ms"
        },
        "default_max_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Max Duration Ms"
        },
        "duration_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/DurationSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "extension_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extension Reason"
        },
        "host_requested_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host Requested Duration Ms"
        },
        "maximum_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Count"
        },
        "maximum_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Duration Ms"
        },
        "minimum_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Count"
        },
        "minimum_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Duration Ms"
        },
        "preferred_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Duration Ms"
        },
        "target_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Count"
        },
        "target_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Duration Ms"
        }
      },
      "title": "ClipConstraints",
      "type": "object"
    },
    "ControlMode": {
      "enum": [
        "auto",
        "guided",
        "directed"
      ],
      "title": "ControlMode",
      "type": "string"
    },
    "DecisionSource": {
      "enum": [
        "host_explicit",
        "host_preset",
        "content_inference",
        "system_capability",
        "fallback"
      ],
      "title": "DecisionSource",
      "type": "string"
    },
    "DimensionApplicability": {
      "enum": [
        "required",
        "weighted",
        "advisory",
        "not_applicable"
      ],
      "title": "DimensionApplicability",
      "type": "string"
    },
    "DimensionKey": {
      "enum": [
        "insight",
        "novelty",
        "emotion",
        "quotability",
        "hook",
        "standalone",
        "clarity",
        "completion",
        "shareability",
        "silent_watchability",
        "pace",
        "editability",
        "subtitle_reliability",
        "visual_independence"
      ],
      "title": "DimensionKey",
      "type": "string"
    },
    "DimensionPolicy": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/DimensionApplicability"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "dimension": {
          "$ref": "#/$defs/DimensionKey"
        },
        "minimum": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/DecisionSource"
        },
        "weight": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        }
      },
      "required": [
        "dimension",
        "applicability",
        "rationale",
        "source"
      ],
      "title": "DimensionPolicy",
      "type": "object"
    },
    "DurationSource": {
      "enum": [
        "host_explicit",
        "content_inference",
        "default_policy",
        "automatic_extension"
      ],
      "title": "DurationSource",
      "type": "string"
    },
    "JsonValue": {},
