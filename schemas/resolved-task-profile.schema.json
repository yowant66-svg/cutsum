{
  "$defs": {
    "CandidateProposalPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_context_dependency": {
          "default": false,
          "title": "Allow Context Dependency",
          "type": "boolean"
        },
        "allow_cross_segment": {
          "default": true,
          "title": "Allow Cross Segment",
          "type": "boolean"
        },
        "preferred_track_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Preferred Track Ids",
          "type": "array"
        }
      },
      "title": "CandidateProposalPolicy",
      "type": "object"
    },
    "ClipConstraints": {
      "additionalProperties": false,
      "properties": {
        "absolute_auto_max_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Absolute Auto Max Duration Ms"
        },
        "default_max_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Max Duration Ms"
        },
        "duration_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/DurationSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "extension_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extension Reason"
        },
        "host_requested_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host Requested Duration Ms"
        },
        "maximum_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Count"
        },
        "maximum_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Duration Ms"
        },
        "minimum_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Count"
        },
        "minimum_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Duration Ms"
        },
        "preferred_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Duration Ms"
        },
        "target_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Count"
        },
        "target_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Duration Ms"
        }
      },
      "title": "ClipConstraints",
      "type": "object"
    },
    "ControlMode": {
      "enum": [
        "auto",
        "guided",
        "directed"
      ],
      "title": "ControlMode",
      "type": "string"
    },
    "DecisionSource": {
      "enum": [
        "host_explicit",
        "host_preset",
        "content_inference",
        "system_capability",
        "fallback"
      ],
      "title": "DecisionSource",
      "type": "string"
    },
    "DimensionApplicability": {
      "enum": [
        "required",
        "weighted",
        "advisory",
        "not_applicable"
      ],
      "title": "DimensionApplicability",
      "type": "string"
    },
    "DimensionKey": {
      "enum": [
        "insight",
        "novelty",
        "emotion",
        "quotability",
        "hook",
        "standalone",
        "clarity",
        "completion",
        "shareability",
        "silent_watchability",
        "pace",
        "editability",
        "subtitle_reliability",
        "visual_independence"
      ],
      "title": "DimensionKey",
      "type": "string"
    },
    "DimensionPolicy": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/DimensionApplicability"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "dimension": {
          "$ref": "#/$defs/DimensionKey"
        },
        "minimum": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/DecisionSource"
        },
        "weight": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        }
      },
      "required": [
        "dimension",
        "applicability",
        "rationale",
        "source"
      ],
      "title": "DimensionPolicy",
      "type": "object"
    },
    "DurationSource": {
      "enum": [
        "host_explicit",
        "content_inference",
        "default_policy",
        "automatic_extension"
      ],
      "title": "DurationSource",
      "type": "string"
    },
    "ExplanationPolicy": {
      "additionalProperties": false,
      "properties": {
        "disclose_assumptions": {
          "default": true,
          "title": "Disclose Assumptions",
          "type": "boolean"
        },
        "explain_content_profile": {
          "default": true,
          "title": "Explain Content Profile",
          "type": "boolean"
        },
        "explain_dimension_scores": {
          "default": true,
          "title": "Explain Dimension Scores",
          "type": "boolean"
        },
        "explain_selection": {
          "default": true,
          "title": "Explain Selection",
          "type": "boolean"
        }
      },
      "title": "ExplanationPolicy",
      "type": "object"
    },
    "JsonValue": {},
    "ResolutionTraceEntry": {
      "additionalProperties": false,
      "properties": {
        "decision_path": {
          "title": "Decision Path",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/DecisionSource"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "decision_path",
        "source",
        "value",
        "rationale"
      ],
      "title": "ResolutionTraceEntry",
      "type": "object"
    },
    "SelectionPolicy": {
      "additionalProperties": false,
      "properties": {
        "duplicate_similarity_threshold": {
          "default": 0.85,
          "maximum": 1,
          "minimum": 0,
          "title": "Duplicate Similarity Threshold",
          "type": "number"
        },
        "maximum_overlap_ratio": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Overlap Ratio",
          "type": "number"
        },
        "prefer_track_diversity": {
          "default": false,
          "title": "Prefer Track Diversity",
          "type": "boolean"
        },
        "preserve_time_order": {
          "default": false,
          "title": "Preserve Time Order",
          "type": "boolean"
        },
        "require_track_diversity": {
          "default": false,
          "title": "Require Track Diversity",
          "type": "boolean"
        }
      },
      "title": "SelectionPolicy",
      "type": "object"
    },
    "SemanticRequirements": {
      "additionalProperties": false,
      "properties": {
        "forbidden_types": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SemanticType"
          },
          "title": "Forbidden Types",
          "type": "array"
        },
        "required_count": {
          "default": 1,
          "minimum": 1,
          "title": "Required Count",
          "type": "integer"
        },
        "required_structure": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Structure",
          "type": "array"
        },
        "semantic_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sequence_constraint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Constraint"
        },
        "speaker_constraint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker Constraint"
        },
        "topic_constraint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Constraint"
        }
      },
      "title": "SemanticRequirements",
      "type": "object"
    },
    "SemanticType": {
      "enum": [
        "definition",
        "reasoning_chain",
        "conflict",
        "hook",
        "step",
        "story_arc"
      ],
      "title": "SemanticType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_policy": {
      "$ref": "#/$defs/CandidateProposalPolicy"
    },
    "content_profile_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Content Profile Id"
    },
    "control_mode": {
      "$ref": "#/$defs/ControlMode"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "dimension_policies": {
      "items": {
        "$ref": "#/$defs/DimensionPolicy"
      },
      "title": "Dimension Policies",
      "type": "array"
    },
    "document_type": {
      "title": "Document Type",
      "type": "string"
    },
    "explanation_policy": {
      "$ref": "#/$defs/ExplanationPolicy"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "final_objectives": {
      "items": {
        "type": "string"
      },
      "title": "Final Objectives",
      "type": "array"
    },
    "hard_constraints": {
      "$ref": "#/$defs/ClipConstraints"
    },
    "hard_exclude_candidate_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Hard Exclude Candidate Ids",
      "type": "array"
    },
    "hard_include_candidate_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Hard Include Candidate Ids",
      "type": "array"
    },
    "host_intent_id": {
      "title": "Host Intent Id",
      "type": "string"
    },
    "prohibited_outcomes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Prohibited Outcomes",
      "type": "array"
    },
    "required_extensions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Extensions",
      "type": "array"
    },
    "resolution_trace": {
      "items": {
        "$ref": "#/$defs/ResolutionTraceEntry"
      },
      "minItems": 1,
      "title": "Resolution Trace",
      "type": "array"
    },
    "resolved_task_id": {
      "title": "Resolved Task Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_policy": {
      "$ref": "#/$defs/SelectionPolicy"
    },
    "semantic_requirements": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticRequirements"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unsatisfied_constraints": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unsatisfied Constraints",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "document_type",
    "created_at",
    "created_by",
    "resolved_task_id",
    "host_intent_id",
    "content_profile_id",
    "control_mode",
    "final_objectives",
    "hard_constraints",
    "dimension_policies",
    "candidate_policy",
    "selection_policy",
    "explanation_policy",
    "resolution_trace"
  ],
  "title": "ResolvedTaskProfile",
  "type": "object"
}
