{
  "$defs": {
    "EscalationReason": {
      "enum": [
        "low_confidence",
        "close_candidate_margin",
        "cross_segment_ambiguity",
        "semantic_conflict",
        "directed_constraint_ambiguity",
        "specialist_terminology",
        "final_quality_gate"
      ],
      "title": "EscalationReason",
      "type": "string"
    },
    "JsonValue": {},
    "ModelTask": {
      "enum": [
        "protocol_validation",
        "hashing_and_provenance",
        "selection_arithmetic",
        "subtitle_layout",
        "media_execution",
        "transcript_cleanup",
        "language_segmentation",
        "keyword_extraction",
        "candidate_prefilter",
        "title_draft",
        "content_profile",
        "intent_interpretation",
        "candidate_proposal",
        "dimension_assessment",
        "semantic_subtitle_grouping",
        "contextual_translation",
        "editorial_selection_review",
        "ambiguity_resolution",
        "specialist_translation_review",
        "final_quality_review"
      ],
      "title": "ModelTask",
      "type": "string"
    },
    "ModelTier": {
      "enum": [
        "deterministic",
        "economy",
        "balanced",
        "frontier"
      ],
      "title": "ModelTier",
      "type": "string"
    },
    "ProviderRecord": {
      "additionalProperties": false,
      "properties": {
        "base_model_tier": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelTier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "cost_minor_units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Minor Units"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "input_hashes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "model_escalation_reasons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EscalationReason"
          },
          "title": "Model Escalation Reasons",
          "type": "array"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "model_task": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelTask"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "output_hashes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Output Hashes",
          "type": "array"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "provider_record_id": {
          "title": "Provider Record Id",
          "type": "string"
        },
        "routing_decision_id": {
          "anyOf": [
            {
              "pattern": "^route-[0-9a-f]{20}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Routing Decision Id"
        },
        "selected_model_tier": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelTier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "started_at",
        "completed_at",
        "provider_record_id",
        "provider_id",
        "operation"
      ],
      "title": "ProviderRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "document_type": {
      "title": "Document Type",
      "type": "string"
    },
    "execution_ids": {
      "items": {
        "type": "string"
      },
      "title": "Execution Ids",
      "type": "array"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "provider_records": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProviderRecord"
      },
      "title": "Provider Records",
      "type": "array"
    },
    "required_extensions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Extensions",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "document_type",
    "created_at",
    "created_by",
    "run_id",
    "plan_id",
    "execution_ids"
  ],
  "title": "RunManifest",
  "type": "object"
}
