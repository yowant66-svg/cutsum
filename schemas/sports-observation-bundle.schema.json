{
  "$defs": {
    "JsonValue": {},
    "SportsEventType": {
      "enum": [
        "score",
        "attempt",
        "save",
        "block",
        "overtake",
        "finish",
        "celebration",
        "controversy",
        "unknown"
      ],
      "title": "SportsEventType",
      "type": "string"
    },
    "SportsModality": {
      "enum": [
        "audio",
        "video",
        "ocr",
        "text",
        "metadata"
      ],
      "title": "SportsModality",
      "type": "string"
    },
    "SportsNarrativeCue": {
      "enum": [
        "decisive_score"
      ],
      "title": "SportsNarrativeCue",
      "type": "string"
    },
    "SportsObservation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "correlation_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Key"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "event_type_hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/SportsEventType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "modality": {
          "$ref": "#/$defs/SportsModality"
        },
        "narrative_cues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SportsNarrativeCue"
          },
          "title": "Narrative Cues",
          "type": "array"
        },
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "observation_type": {
          "$ref": "#/$defs/SportsObservationType"
        },
        "provider_record_ref": {
          "title": "Provider Record Ref",
          "type": "string"
        },
        "replay_of_correlation_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replay Of Correlation Key"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "temporal_role": {
          "$ref": "#/$defs/SportsTemporalRole"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "observation_id",
        "source_id",
        "observation_type",
        "modality",
        "temporal_role",
        "start_ms",
        "end_ms",
        "confidence",
        "label",
        "provider_record_ref"
      ],
      "title": "SportsObservation",
      "type": "object"
    },
    "SportsObservationType": {
      "enum": [
        "audio_peak",
        "shot_change",
        "motion_burst",
        "scoreboard_change",
        "ocr_text",
        "commentator_emphasis",
        "replay_start",
        "replay_end",
        "event_classification"
      ],
      "title": "SportsObservationType",
      "type": "string"
    },
    "SportsTemporalRole": {
      "enum": [
        "buildup",
        "action",
        "outcome",
        "reaction",
        "replay"
      ],
      "title": "SportsTemporalRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "title": "Bundle Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "document_type": {
      "title": "Document Type",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/SportsObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "provider_kind": {
      "enum": [
        "fixture",
        "host_ai_file",
        "human_file",
        "local_detector"
      ],
      "title": "Provider Kind",
      "type": "string"
    },
    "provider_record_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Provider Record Refs",
      "type": "array"
    },
    "required_extensions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Extensions",
      "type": "array"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "document_type",
    "created_at",
    "created_by",
    "bundle_id",
    "source_id",
    "provider_kind",
    "provider_record_refs",
    "observations"
  ],
  "title": "SportsObservationBundle",
  "type": "object"
}
